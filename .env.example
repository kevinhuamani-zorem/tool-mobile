# Copia este archivo como .env dentro de tools/visual-recorder.
# También puede configurarse en config/workspace.json.
# RECORDER_MODE=fwk-mobile
# TARGET_PROJECT=/ruta/al/proyecto
# Proveedor local para resolver únicamente gaps del plan: copilot (default) o claude.
# AUTOMATION_AGENT=copilot
# COPILOT_CLI_PATH=/ruta/opcional/copilot
# CLAUDE_CLI_PATH=/ruta/opcional/claude
