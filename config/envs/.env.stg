# REDIS
REDIS_HOST=redieu2yapec13.redis.cache.windows.net
#Copiar la credencial aqui o definir la variable de entorno en su .zshrc con el nombre redis_password_stg
REDIS_PASSWORD=''

# BrowserStack Local Tunnel (set to true only when running locally with an active tunnel)
BROWSERSTACK_LOCAL=false

# BCP MOCKMBRK SERVER
URL_MOCK=https://azfdeu2yaped10.azurefd.net/mocks-stg/stg
WALLE_UPDATE_USER_PERSONALITY=/yape/ChangeUserPersonality

APP_ANDROID_NAME=app-stg-release.apk
APP_IOS_NAME=app-stg-release.ipa
APP_YAPE_PACKAGE=com.yape.stg

# tag ejecucion
TAG_NAME=@smoke_mobile

BUNDLE_ID=com.yape.stg

# Automation Configurations
CONFIG_DEFAULT_DISPLAY_TIMEOUT=5000
CONFIG_DEFAULT_DISPLAY_TIMEOUT_MAX=60000

# Server URL Azure
URL_SERVER_AZURE=https://azfdeu2yapec10.azurefd.net
GET_MENU_ITEMS_FROM_HOME=/yap-lan-v3/channel/yapeapp/v3/landing/menu
GET_BS_ACC_UUID=/bus-acc-v4/party/party-data-management/v4/accounts

# Server URL B2C
URL_SERVER_B2C=https://yapecer.b2clogin.com/yapecer.onmicrosoft.com
GET_BASE_AUTH_TOKEN_B2C=/B2C_1A_Pruebas_Onboarding/oauth2/v2.0/token
GET_AUTH_TOKEN_B2C=/B2C_1A_yape_personas_unlock_mobile/oauth2/v2.0/token

# Variables for auth b2c
B2C_REQUEST_STATES=ACTIVE
B2C_REQUEST_CODE=YP
B2C_REQUEST_CALLER_NAME=yapeapp

B2C_REQUEST_GRANT_TYPE=password
B2C_REQUEST_RESPONSE_TYPE=id_token
B2C_REQUEST_AUTH_RESULT=authorized
B2C_REQUEST_EXTENSION_XCHANNEL= 1
B2C_REQUEST_EXPERIMENTGROUP=NO-GROUP
B2C_REQUEST_APP_VERSION=3.43.0
B2C_REQUEST_CODE_CHALLENGE_METHOD=S256

# Do not push this variables value
B2C_REQUEST_ID=enter_request_id_here
B2C_REQUEST_USER_PASSWORD=enter_password_for_auth_account_B2C
B2C_REQUEST_OCP_APIM_SUBSCRIPTION_KEY=enter_ocp_apim_subscription_key_here
B2C_REQUEST_CLIENT_ID=enter_client_id_here
B2C_REQUEST_ID_YAPE_ACCOUNT_BASE=enter_yape_account_base_id_here

