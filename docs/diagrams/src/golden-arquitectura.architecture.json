  "cards": [
    {
      "dot": "rose",
      "title": "La autoridad son las publicaciones",
      "items": [
        "Eventos encadenados por hash de aprobación o revocación; nunca se reemplaza uno previo",
        "El índice solo proyecta la última versión activa y se comprueba en cada lectura",
        "Un caso corrupto se excluye con diagnóstico, sin rescatar una aprobación anterior"
      ]
    },
    {
      "dot": "emerald",
      "title": "Aprobar no es exportar",
      "items": [
        "Publicar golden no escribe el framework ni el recibo de exportación",
        "El token queda ligado a paquete, revisión, contenido y checkout",
        "Cambiar el código o el contexto crea otra versión y sustituye la referencia activa"
      ]
    },
    {
      "dot": "cyan",
      "title": "Qué recibe cada rol",
      "items": [
        "Lorem recibe Feature y Steps aceptados; Zorem, Screen Object y Locators",
        "Sumrak solo recibe lecciones y relaciones verificadas de su error o gap abierto",
        "Las consultas viajan por archivos dentro de la misma invocación: sin otra sesión ni shell"
      ]
    }
  ]
