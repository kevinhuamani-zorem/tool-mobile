        "focus": [
          "check",
          "edited",
          "invalid",
          "saving"
        ],
        "note": "Una corrección obliga a revalidar; si falla, no se escribe nada."
      },
      {
        "id": "reuso",
        "label": "Qué se hace después",
        "focus": [
          "stored",
          "seed"
        ],
        "note": "Solo los casos válidos al 100 % con fingerprint nuevo llegan a la memoria."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Ciclo del caso"
    },
    {
      "id": "revision",
      "label": "Corrección y rechazo"
    },
    {
      "id": "memoria",
      "label": "Reutilización"
    }
  ],
  "states": [
    {
      "id": "applied",
      "type": "start",
      "label": "Paquete aplicado",
      "sublabel": "4 capas en el fwk",
      "lane": "main",
      "col": 0,
      "step": "01"
    },
    {
      "id": "saving",
      "type": "active",
      "label": "Guardar dataset",
      "sublabel": "paso 3 o script",
      "lane": "main",
      "col": 1,
      "step": "02"
    },
    {
      "id": "check",
      "type": "decision",
      "label": "¿Hubo corrección?",
      "sublabel": "editor › disco",
      "lane": "main",
      "col": 2,
      "step": "03"
    },
    {
      "id": "write",
      "type": "active",
      "label": "Escribe el caso",
      "sublabel": "manifest y expected",
      "lane": "main",
      "col": 3,
      "step": "04"
    },
    {
      "id": "stored",
      "type": "success",
