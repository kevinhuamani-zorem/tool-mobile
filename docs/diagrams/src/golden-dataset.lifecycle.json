      "col": 1,
      "tag": "recuperable",
      "yOffset": 84
    },
    {
      "id": "seed",
      "type": "external",
      "label": "Memoria sembrada",
      "sublabel": "seed-memory",
      "lane": "memoria",
      "col": 2,
      "tag": "100 %"
    }
  ],
  "transitions": [
    {
      "id": "t-save",
      "from": "applied",
      "to": "saving"
    },
    {
      "id": "t-check",
      "from": "saving",
      "to": "check",
      "route": "straight"
    },
    {
      "id": "t-edit",
      "from": "check",
      "to": "edited",
      "label": "sí",
      "variant": "emphasis",
      "labelAt": [
        402,
        202
      ]
    },
    {
      "id": "t-reuse",
      "from": "check",
      "to": "write",
      "label": "no",
      "route": "straight",
      "labelAt": [
        440,
        202
      ]
    },
    {
      "id": "t-revalidate",
      "from": "edited",
      "to": "write",
      "label": "revalida",
      "variant": "emphasis"
    },
    {
      "id": "t-fail",
      "from": "edited",
      "to": "invalid",
      "variant": "security"
    },
    {
      "id": "t-retry",
      "from": "invalid",
      "to": "saving",
      "label": "corrige y reintenta",
      "variant": "security",
      "route": "bottom-channel",
      "fromSide": "bottom",
      "toSide": "bottom"
    },
    {
      "id": "t-store",
      "from": "write",
      "to": "stored"
    },
    {
      "id": "t-seed",
      "from": "stored",
      "to": "seed",
      "label": "fingerprint nuevo",
      "variant": "dashed",
      "labelAt": [
        710,
        245
      ]
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Qué queda guardado",
      "items": [
        "manifest.json con squad, ejecución y notas del QA",
        "package/ con la whitelist de archivos y las baselines del framework",
        "catalog.json sin telemetría y la respuesta del agente ya aceptada",
        "expected/<capa>-<archivo> con el contenido que debe volver a salir"
      ]
    },
    {
      "dot": "amber",
      "title": "La corrección manda",
      "items": [
        "El orden de verdad es editor › disco › agent-response",
        "Con corrección se revalida antes de escribir: si falla, no se toca nada",
        "Al aceptar se regeneran application-receipt, agent-response y validation"
      ]
    },
    {
      "dot": "cyan",
      "title": "Para qué sirve después",
      "items": [
        "golden:save toma lo que hay en disco, aunque la corrección sea de días después",
        "golden:seed-memory promueve a memoria solo los casos válidos al 100 %",
        "test:golden repite el caso resolviendo con catálogo y snapshot"
      ]
    }
  ]
}