  "cards": [
    {
      "dot": "rose",
      "title": "Frontera de confianza",
      "items": [
        "El renderer corre sin Node y solo alcanza la allowlist de preload",
        "Todo payload se valida en main: TypeScript del renderer no es una frontera",
        "El Inspector embebido nunca entrega WebDriver ni credenciales al renderer"
      ]
    },
    {
      "dot": "emerald",
      "title": "Lo determinista manda",
      "items": [
        "El resolver decide reuse/create y fija las cuatro rutas antes de cualquier agente",
        "La IA solo recibe los gaps abiertos y su mitad proyectada del borrador",
        "La memoria por fingerprint y por fragmentos evita invocar al agente"
      ]
    },
    {
      "dot": "amber",
      "title": "Escritura segura",
      "items": [
        "outputValidator fija rutas permitidas, sintaxis y hashes",
        "Snapshots por destino: aplicar comprueba que sigan intactos",
        "Solo artefactos aprobados salen del runtime hacia el framework"
      ]
    }
  ]
