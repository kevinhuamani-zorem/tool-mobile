{
  "name": "appium-visual-recorder",
  "version": "1.0.0",
  "private": true,
  "description": "Visual mobile test recorder with Appium and Cucumber",
  "main": "dist/recorder/src/main.js",
  "scripts": {
    "recorder": "./run.sh",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc",
    "build:renderer": "vite build",
    "inspector:build": "node scripts/build-embedded-inspector.js",
    "inspector:check": "node scripts/build-embedded-inspector.js --check",
    "runtime-origin:write": "node scripts/write-runtime-origin.js",
    "start": "npm run build && electron .",
    "package:mac": "npm run build && npm run inspector:check && npm run runtime-origin:write && electron-builder --mac dir --publish never && node scripts/reveal-macos-app.js",
    "dmg:mac": "npm run build && npm run inspector:check && npm run runtime-origin:write && electron-builder --mac dmg --publish never",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json",
    "test": "npm run build:main && node --test tests/*.test.js",
    "architecture:check": "node scripts/check-architecture.js",
    "quality:metrics": "npm run build:main && node scripts/quality-metrics.js",
    "quality": "npm run typecheck && npm run architecture:check && npm test && npm run quality:metrics && npm run build",
    "codegraph:export": "npm run build:main --silent && node scripts/export-codegraph.js",
    "codegraph:recorder": "npm run build:main --silent && node scripts/export-recorder-codegraph.js",
    "phase43:refresh-canonical": "npm run build:main && node scripts/phase43-refresh-canonical.js",
    "test:phase43:deterministic": "npm run build:main && node --test tests/phase43DeterministicRegression.test.js",
    "test:phase43:baseline": "node scripts/phase43-baseline.js"
  },
  "author": "Kevin Huamani",
  "license": "MIT",
  "build": {
    "appId": "com.kevinarnold.appium-visual-recorder",
    "productName": "Appium Visual Recorder",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      {
        "from": "build/runtime-origin.json",
        "to": "runtime-origin.json"
      },
      {
        "from": "node_modules/.cache/appium-inspector/63f544c5afca2d89244914c165cd14434d1cfdee",
        "to": "app/node_modules/.cache/appium-inspector/63f544c5afca2d89244914c165cd14434d1cfdee"
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Appium Visual Recorder ${version}"
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@appium/base-driver": "10.6.0",
    "appium": "3.5.0",
    "appium-uiautomator2-driver": "8.4.0",
    "appium-xcuitest-driver": "12.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.0.0",
    "webdriverio": "^8.0.0"
  }
}
