{
  "name": "appium-visual-recorder",
  "version": "1.0.0",
  "private": true,
  "description": "Visual mobile test recorder with Appium and Cucumber",
  "main": "dist/recorder/src/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json"
  },
  "author": "Kevin Huamani",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@wdio/appium-service": "^8.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "webdriverio": "^8.0.0"
  }
}
