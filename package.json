{
  "name": "poc-all-in-one-webdriverio",
  "version": "5.3.1",
  "author": "Wim Selles <wim@wswebcreation.nl>",
  "license": "MIT",
  "description": "Poc All in one Webdriver io - Mobile Web and apis testing",
  "homepage": "https://github.com/webdriverio/appium-boilerplate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdriverio/appium-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/webdriverio/appium-boilerplate/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "keywords": [
    "WebdriverIO",
    "WebDriver",
    "appium",
    "native app",
    "hybrid",
    "android",
    "ios"
  ],
  "type": "module",
  "scripts": {
    "android-qa": "NODE_ENV=qa npm run wdio-cucumber",
    "android-stg": "NODE_ENV=stg npm run wdio-cucumber",
    "ios-qa": "NODE_ENV=qa npm run wdio-cucumber-ios",
    "ios-stg": "NODE_ENV=stg npm run wdio-cucumber-ios",
    "android-qa.bws.app": "NODE_ENV=qa wdio run ./config/browserstack/wdio.android.bs.app.conf.ts",
    "android-stg.bws.app": "NODE_ENV=stg wdio run ./config/browserstack/wdio.android.bs.app.conf.ts",
    "ios-qa.bws.app": "NODE_ENV=qa wdio run ./config/browserstack/wdio.ios.bs.app.conf.ts",
    "ios-stg.bws.app": "NODE_ENV=stg wdio run ./config/browserstack/wdio.ios.bs.app.conf.ts",
    "wdio-cucumber": "wdio run ./config/wdio.android.conf.ts",
    "wdio-cucumber-ios": "wdio run ./config/wdio.ios.conf.ts",
    "allure-report": "allure generate --clean ./reports/allure/allure-results -o ./reports/allure/allure-report && NODE_NO_WARNINGS=1 allure open --port 8080 ./reports/allure/allure-report",
    "bt:tm:report": "node scripts/browserstack-tm-reporter.js",
    "validate:squads": "node scripts/validate-squad-sync.js",
    "postinstall": "node scripts/fix-vuln-nested-deps.cjs"
  },
  "dependencies": {
    "@azure/cosmos": "4.9.3",
    "allure-commandline": "2.40.0",
    "axios-curlirize": "2.0.0",
    "chromedriver": "143.0.4",
    "date-fns": "4.1.0",
    "form-data": "4.0.6",
    "glob": "13.0.6",
    "js-yaml": "4.2.0",
    "jsonwebtoken": "9.0.3",
    "node-redis-scan": "1.3.9",
    "redis": "5.12.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "12.8.3",
    "@types/axios": "0.14.4",
    "@types/chai": "5.2.3",
    "@types/glob": "9.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "25.7.0",
    "@types/uuid": "11.0.0",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@wdio/allure-reporter": "9.27.1",
    "@wdio/appium-service": "9.27.2",
    "@wdio/browserstack-service": "9.27.2",
    "@wdio/cli": "9.27.2",
    "@wdio/cucumber-framework": "9.27.1",
    "@wdio/globals": "9.27.1",
    "@wdio/local-runner": "9.27.2",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/shared-store-service": "9.27.2",
    "@wdio/spec-reporter": "9.27.1",
    "appium": "3.5.0",
    "appium-uiautomator2-driver": "7.6.2",
    "appium-xcuitest-driver": "11.13.0",
    "axios": "1.18.0",
    "chai": "6.2.2",
    "dotenv-flow": "4.1.0",
    "esbuild": "0.28.1",
    "eslint-plugin-wdio": "9.27.1",
    "multiple-cucumber-html-reporter": "3.10.0",
    "node-simctl": "8.2.3",
    "prettier": "3.8.3",
    "ts-node": "10.9.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "wdio-cucumberjs-json-reporter": "6.0.1"
  },
  "overrides": {
    "axios": "$axios",
    "form-data": "4.0.6",
    "fast-xml-parser": "5.7.3",
    "serialize-javascript": "7.0.5",
    "tar": "7.5.16",
    "minimatch": "10.2.5",
    "undici": "7.28.0",
    "yauzl": "3.3.0",
    "yaml": "2.9.0",
    "@appium/docutils": "2.4.2",
    "@appium/support": "7.2.2",
    "@appium/base-driver": "10.5.2",
    "@xmldom/xmldom": "0.9.10",
    "uuid": "14.0.0",
    "node-simctl": "8.2.3",
    "follow-redirects": "1.16.0",
    "plist": "4.0.0",
    "appium-uiautomator2-driver": {
      "@xmldom/xmldom": "0.9.10",
      "uuid": "14.0.0",
      "follow-redirects": "1.16.0",
      "@appium/support": "7.2.2",
      "@appium/base-driver": "10.5.2",
      "@appium/docutils": "2.4.2",
      "plist": "5.0.0"
    },
    "lodash": "4.18.1",
    "basic-ftp": "6.0.1",
    "protobufjs": "8.2.0",
    "path-to-regexp": "8.4.2",
    "qs": "6.15.2",
    "tmp": "0.2.7",
    "ws": "8.21.0",
    "semver": "7.8.0",
    "braces": "3.0.3",
    "brace-expansion": "5.0.7",
    "micromatch": "4.0.8",
    "cross-spawn": "7.0.6",
    "shell-quote": "1.8.4",
    "morgan": "1.11.0" 
  },
  "resolutions": {
    "@xmldom/xmldom": "0.9.10",
    "plist": "3.1.1",
    "uuid": "14.0.0",
    "minimatch": "10.2.5",
    "path-to-regexp": "8.3.1",
    "tmp": "0.2.7",
    "axios": "1.18.0",
    "brace-expansion": "5.0.7",
    "yaml": "2.8.3",
    "shell-quote": "1.8.4"
  }
}
