{
  "name": "appium-visual-recorder",
  "version": "1.0.0",
  "private": true,
  "description": "Visual mobile test recorder with Appium and Cucumber",
  "main": "dist/recorder/src/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json",
    "test": "npm run build:main && node --test tests/*.test.js",
    "quality:metrics": "npm run build:main && node scripts/quality-metrics.js",
    "quality": "npm run typecheck && npm test && npm run quality:metrics && npm run build",
    "codegraph:export": "npm run build:main --silent && node scripts/export-codegraph.js",
    "codegraph:recorder": "npm run build:main --silent && node scripts/export-recorder-codegraph.js"
  },
  "author": "Kevin Huamani",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "ts-node": "^10.9.2",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@wdio/appium-service": "^8.0.0",
    "appium": "3.5.0",
    "appium-uiautomator2-driver": "8.4.0",
    "appium-xcuitest-driver": "12.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.0.0",
    "webdriverio": "^8.0.0"
  }
}
