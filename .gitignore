# Dependencias y compilación
node_modules/
dist/
release/
/build/runtime-origin.json

# Defensa adicional: el recorder no usa este archivo, pero nunca debe versionarse.
.env

# Evidencia, memoria, caché y salidas locales
runtime/**
!runtime/.gitignore
/coverage/
test-results/

# Logs y archivos del sistema/editor
*.log
*.err
.DS_Store
.idea/
.vscode/

# Proyecciones y temporales golden; las versiones/publicaciones aprobadas sí se conservan.
/tests/golden/approved-index.json
/tests/golden/.publication.lock
/tests/golden/**/.pending-*
/tests/golden/*.tmp

# Selección local del checkout compartido; no viaja entre máquinas.
/config/golden-repository.json
/config/golden-repository.json.*.tmp
